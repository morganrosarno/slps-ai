# Configurare queste variabili sul server; non inserire valori reali nel repository.
OPENAI_API_KEY=
OPENAI_MODEL=
# Minimo 16 caratteri; password riservata del proprietario.
SLPS_PILOT_PASSWORD=
# Almeno 32 caratteri casuali, distinto dalla password.
SLPS_SESSION_SECRET=
# Facoltativo: default private/SLPS_AI_Prompt_Master_v1.8.txt
SLPS_PROMPT_PATH=
# Facoltativo: file JSON privato di fonti verificate dal proprietario.
SLPS_SOURCES_PATH=
SLPS_COOKIE_SECURE=true
SLPS_ANALYSES_PER_HOUR=10
# La prova gratuita è un limite totale distinto dalla protezione oraria.
SLPS_PILOT_PLAN=trial
SLPS_TRIAL_ANALYSES_TOTAL=1
SLPS_MAX_IMAGE_BYTES=10485760
SLPS_MAX_VIDEO_BYTES=52428800
SLPS_MAX_VIDEO_SECONDS=30
# Facoltativo: in produzione indicare un volume persistente.
# SLPS_RATE_DB_PATH=/percorso/persistente/limits.sqlite3
# SLPS_CASE_DB_PATH=/percorso/persistente/cases.sqlite3
# Cartella privata separata per originali foto/video e artefatti derivati.
# SLPS_HISTORY_ROOT=/percorso/persistente/history-media
# Il limite blocca nuovi salvataggi senza cancellare lo storico esistente.
SLPS_MAX_HISTORY_BYTES_PER_TENANT=1073741824
SLPS_PILOT_TENANT_ID=pilot
SLPS_PILOT_OWNER_ID=owner
SLPS_MAX_CASES_PER_OWNER=100

# Opt-in local account foundation. Defaults preserve the single-owner pilot.
# In accounts mode SLPS_PILOT_PASSWORD and pilot principal IDs are not used.
# Keep registration closed until email verification/reset delivery exists.
# The account DB path must be explicit and persistent outside the application code.
SLPS_AUTH_MODE=pilot
SLPS_ACCOUNT_REGISTRATION_OPEN=false
# SLPS_ACCOUNT_DB_PATH=/percorso/persistente/accounts.sqlite3

# Simulazione locale e non transazionale. Default false: con il flag spento
# tutte le route /api/sandbox/billing sono indisponibili. Non collega provider,
# non accetta carte e non attiva piani o quote.
SLPS_BILLING_SANDBOX_ENABLED=false
# Limite atomico di simulazioni ancora aperte per azienda e utente (1-100).
SLPS_BILLING_SANDBOX_MAX_OPEN_INTENTS=5
